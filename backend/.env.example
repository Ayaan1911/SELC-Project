# Copy this file to backend/.env (which is git-ignored - never commit real secrets).
#
#   cp backend/.env.example backend/.env
#
# Then replace the value below with a long random secret, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

SECURECART_JWT_SECRET=replace-this-with-a-long-random-value
